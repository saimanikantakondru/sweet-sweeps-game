  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9cc89d09384815c45b3f4771e4cc74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SweetSweeps.Menu.UI.InfoPopupView
  root: {fileID: 1913123106}
  titleText: {fileID: 2022236701}
  bodyText: {fileID: 222481340}
  closeButton: {fileID: 1999779173}
  backdropButton: {fileID: 1903335199}
  bodyScrollRect: {fileID: 826072533}
  defaultTitle: How to Play
  defaultBody: "<color=#FFD200>Coney's Coin Calamity</color> is a side-scrolling
    platformer. Survive and grab as many coins as you can \u2014 the longer you last,
    the more you collect.\n\n<b>How to Play:</b>\n- Move and jump across platforms
    \u2014 you can <color=#FFD200>double jump</color>, or press down to <color=#FFD200>drop
    through</color> one-way platforms.\n- Collect <color=#FFD200>Gold Coins (GC)</color>
    \u2014 Each Gold Coin value depends on the selected bet.\n- <color=#FFD200>Sweepstakes
    Coins (SC)</color> are rare and far more valuable \u2014 each adds a random SC
    value, so grab every one you see.\n- Avoid <color=#FFD200>Red Coins</color> \u2014
    they cut gold points you've already earned.\n\n<b>Hazards:</b>\n- <color=#FFD200>Ice
    Picks</color> and <color=#FFD200>Lava</color> cost you 1 HP.\n- <color=#FFD200>Chasms</color>
    kill you instantly \u2014 time your jumps.\n- <color=#FFD200>Frosted</color>
    and <color=#FFD200>Sticky</color> floors make movement slippery or sluggish.\n-
    When the round timer runs low, the world starts <color=#FFD200>crumbling in</color>
    behind you \u2014 keep moving or get caught.\n\n<b>Controls:</b>\n- <color=#FFD200>Move</color>
    \u2014 A / D or \u2190 / \u2192 \xB7 Mobile: joystick\n- <color=#FFD200>Jump
    / Double Jump</color> \u2014 Space \xB7 Mobile: touch right panel\n- <color=#FFD200>Drop
    Through Platform</color> \u2014 S or \u2193 \xB7 Mobile: swipe down"
