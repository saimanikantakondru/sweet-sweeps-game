  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Coney's Coin Calamity</b> is a side-scrolling platformer set across
    candy-themed worlds. Your goal is to collect as many coins as you can and survive
    as long as possible.\n\n<color=#FFD200><b>How to Play:</b></color>\n- Run through
    the level, jump over gaps, and use a <b>double jump</b> to reach higher platforms.\n-
    <b>Drop</b> through one-way platforms by pressing down to reach lower paths.\n-
    Collect <b>Gold Coins (GC)</b> \u2014 1 GC in game equals 1 GC in your wallet.\n-
    Hunt for <b>Sweepstakes Coins (SC)</b> \u2014 the rarest and most valuable reward
    in the game. They appear far less often than Gold Coins, and every single one
    is worth chasing: each SC adds a random SC value straight to your wallet. Grab
    them whenever you see one.\n- Coins keep appearing throughout the run, so prioritize
    grabbing as many as possible before you fall or run out of <b>HP</b>.\n\n<color=#FFD200><b>Hazards
    to Avoid:</b></color>\n- <b>Red Coins</b> \u2014 corrupted coins mixed in with
    Gold Coins. Picking one up reduces the points you've earned from your collected
    Gold Coins, so dodge them.\n- <b>Frosted Floor</b> \u2014 slippery ice surfaces
    that reduce your control and make it easy to slide into danger.\n- <b>Sticky
    Floor</b> \u2014 gummy surfaces that slow you down and drag your movement, making
    jumps and timing harder.\n- <b>Ice Picks</b> \u2014 stationary ice spikes. Touching
    them costs you <b>1 HP</b>.\n- <b>Lava Pits</b> \u2014 pools of lava. Contact
    costs you <b>1 HP</b>.\n- <b>Chasms</b> \u2014 bottomless gaps between platforms.
    Fall into one and your run ends instantly, so time your jumps carefully.\n\n<color=#FFD200><b>World
    Decay:</b></color>\n- As the round timer runs out, the world begins to <b>decay</b>
    \u2014 platforms, decor, and ground crumble away in waves, starting from behind
    you and closing in. Keep moving and grab what you can: once the level falls apart,
    the run is over.\n\n<color=#FFD200><b>Controls:</b></color>\n- <b>Move Left /
    Right</b> \u2014 Desktop: Arrow Keys \xB7 Mobile: Left-hand joystick\n- <b>Jump</b>
    \u2014 Desktop: Space \xB7 Mobile: Touch (right-hand panel)\n- <b>Double Jump</b>
    \u2014 Desktop: Double-tap Space \xB7 Mobile: Double Touch (right-hand panel)\n-
    <b>Drop Through Platform</b> \u2014 Desktop: Down Arrow \xB7 Mobile: Swipe down
    (right-hand panel)"
  m_isRightToLeft: 0
